<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sisi') %>
<div class="admin-utama">
  <div class="admin-topbar">
    <div><h1><%= judul %></h1><span class="kecil samar"><%= util.formatAngka(hit) %> entri terdaftar</span></div>
    <div class="kanan">
      <a class="tombol kecil" href="/admin/dip/form"><svg width="14" height="14"><use href="#i-plus"></use></svg> Tambah Entri</a>
      <span class="badge-klon"><%= cfg.suffix %></span>
    </div>
  </div>

  <div class="admin-isi">
    <% if (flash) { %><div class="pesan ok"><%= flash %></div><% } %>

    <form class="bilah-filter" method="get" action="/admin/dip">
      <div class="field grow">
        <label for="q">Cari Ringkasan Informasi</label>
        <input id="q" name="q" type="search" value="<%= query.q || '' %>" placeholder="Kata kunci…">
      </div>
      <div class="field">
        <label for="kategori">Kategori</label>
        <select id="kategori" name="kategori">
          <option value="">Semua</option>
          <% kategoriDip.forEach(function(k){ %><option value="<%= k.slug %>" <%= query.kategori === k.slug ? 'selected' : '' %>><%= k.nama %></option><% }) %>
        </select>
      </div>
      <div class="fleks" style="gap:.5rem">
        <button class="tombol" type="submit"><svg width="14" height="14"><use href="#i-cari"></use></svg> Saring</button>
        <a class="tombol garis" href="/admin/dip">Atur Ulang</a>
      </div>
    </form>

    <div class="tabel-bungkus">
      <table class="tabel">
        <thead><tr><th class="nomor">#</th><th>Ringkasan Informasi</th><th>Kategori</th><th>PD</th><th>Jenis</th><th>Format</th><th>Tahun</th><th>Unduh/Lihat</th><th class="kanan">Aksi</th></tr></thead>
        <tbody>
          <% baris.forEach(function(d, i){ %>
            <tr>
              <td class="nomor"><%= pg.offset + i + 1 %></td>
              <td style="max-width:320px"><a href="/informasi/<%= d.id %>" target="_blank" rel="noopener" style="text-decoration:none;font-weight:600"><%= d.ringkas_informasi %></a></td>
              <td><span class="lencana aksen"><%= d.kategori_nama %></span></td>
              <td class="kecil redup"><%= d.opd_singkatan || '—' %></td>
              <td class="kecil"><%= d.jenis %></td>
              <td class="kecil"><%= d.format %></td>
              <td class="kecil"><%= d.tahun || '—' %></td>
              <td class="kecil samar"><%= d.unduhan %> / <%= d.dilihat %></td>
              <td class="aksi">
                <a class="tombol garis kecil" href="/admin/dip/form/<%= d.id %>"><svg width="13" height="13"><use href="#i-sunting"></use></svg></a>
                <form method="post" action="/admin/dip/<%= d.id %>/hapus" style="display:inline">
                  <input type="hidden" name="csrf" value="<%= csrf %>">
                  <button class="tombol garis kecil" data-konfirmasi="Hapus entri DIP ini?" title="Hapus"><svg width="13" height="13"><use href="#i-hapus"></use></svg></button>
                </form>
              </td>
            </tr>
          <% }) %>
          <% if (!baris.length) { %><tr><td colspan="9" class="tengah redup" style="padding:2rem">Tidak ada entri.</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <%- include('../partials/paginasi', { pg: pg, baseUrl: '/admin/dip', query: query }) %>
  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
