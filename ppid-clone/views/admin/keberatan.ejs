<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sisi') %>
<div class="admin-utama">
  <div class="admin-topbar">
    <div><h1><%= judul %></h1><span class="kecil samar"><%= baris.length %> pengajuan tercatat</span></div>
    <div class="kanan"><span class="badge-klon"><%= cfg.suffix %></span></div>
  </div>

  <div class="admin-isi">
    <% if (flash) { %><div class="pesan ok"><%= flash %></div><% } %>

    <% baris.forEach(function(k){ %>
      <div class="panel mb-2">
        <div class="kepala">
          <div>
            <h3 style="margin:0"><span class="mono"><%= k.nomor_tiket %></span> · <%= k.nama %></h3>
            <span class="kecil samar">Diajukan <%= util.tanggalID(k.dibuat) %><%= k.tiket_permohonan ? ' · merujuk permohonan ' + k.tiket_permohonan : '' %></span>
          </div>
          <span class="lencana <%= util.WARNA_STATUS[k.status] || 'info' %>"><%= k.status %></span>
        </div>
        <div class="isi-panel">
          <div class="baris grid-2 mb-1">
            <div><span class="kecil samar">Alasan Keberatan</span><div class="tebal"><%= k.alasan %></div></div>
            <div><span class="kecil samar">Kontak</span><div class="kecil"><%= k.email %><%= k.telepon ? ' · ' + k.telepon : '' %></div></div>
          </div>
          <div class="mb-1"><span class="kecil samar">Uraian</span><div><%= k.uraian %></div></div>
          <% if (k.tanggapan) { %><div class="note mb-1"><strong>Tanggapan:</strong> <%= k.tanggapan %><% if (k.dijawab) { %> <span class="samar mikro">(<%= util.tanggalID(k.dijawab) %>)</span><% } %></div><% } %>

          <form method="post" action="/admin/keberatan/<%= k.id %>/tanggapi" class="form-grid mt-1">
            <input type="hidden" name="csrf" value="<%= csrf %>">
            <div class="field kolom-4">
              <label for="st-<%= k.id %>">Status</label>
              <select id="st-<%= k.id %>" name="status">
                <% ['Menunggu Telaah','Sedang Ditelaah','Ditanggapi','Diteruskan ke Atasan PPID','Ditolak'].forEach(function(s){ %>
                  <option value="<%= s %>" <%= k.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </div>
            <div class="field kolom-8">
              <label for="tg-<%= k.id %>">Tanggapan Tertulis</label>
              <textarea id="tg-<%= k.id %>" name="tanggapan" style="min-height:70px"><%= k.tanggapan || '' %></textarea>
            </div>
            <div class="field kolom-12">
              <div class="fleks">
                <button class="tombol kecil" type="submit"><svg width="14" height="14"><use href="#i-sukses"></use></svg> Simpan Tanggapan</button>
                <a class="tombol garis kecil" href="mailto:<%= k.email %>?subject=Keberatan%20<%= encodeURIComponent(k.nomor_tiket) %>">Balas via Surel</a>
                <% if (user.role === 'admin') { %>
                  <button class="tombol bahaya kecil" form="hapus-kbr-<%= k.id %>" data-konfirmasi="Hapus keberatan <%= k.nomor_tiket %>?" type="submit"><svg width="14" height="14"><use href="#i-hapus"></use></svg> Hapus</button>
                <% } %>
              </div>
            </div>
          </form>
          <% if (user.role === 'admin') { %>
            <form id="hapus-kbr-<%= k.id %>" method="post" action="/admin/keberatan/<%= k.id %>/hapus">
              <input type="hidden" name="csrf" value="<%= csrf %>">
            </form>
          <% } %>
        </div>
      </div>
    <% }) %>
    <% if (!baris.length) { %><div class="panel"><div class="isi-panel tengah redup">Belum ada pengajuan keberatan.</div></div><% } %>
  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
