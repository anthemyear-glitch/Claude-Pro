<%- include('../partials/admin-head') %>
<div class="login-layar" style="flex:1">
  <div class="login-kotak">
    <div class="tengah mb-2">
      <svg width="56" height="56" viewBox="0 0 64 64" aria-hidden="true">
        <circle cx="32" cy="32" r="28" fill="none" stroke="var(--aksen)" stroke-width="3"/>
        <path d="M32 15l12 5v10c0 8-5 14-12 16-7-2-12-8-12-16V20z" fill="none" stroke="var(--aksen-2)" stroke-width="3" stroke-linejoin="round"/>
        <path d="M26 32h12M32 26v12" stroke="var(--aksen)" stroke-width="3" stroke-linecap="round"/>
      </svg>
      <h1 style="font-size:1.25rem;margin:.5rem 0 .1rem">Panel Pengelola PPID</h1>
      <p class="kecil redup mb-0"><%= cfg.siteName %> · salinan cadangan <strong style="color:var(--aksen)"><%= cfg.suffix %></strong></p>
    </div>

    <% if (galat) { %><div class="pesan galat"><svg width="16" height="16"><use href="#i-peringatan"></use></svg> <%= galat %></div><% } %>
    <% if (flash) { %><div class="pesan info"><%= flash %></div><% } %>

    <form method="post" action="/admin/login">
      <input type="hidden" name="csrf" value="<%= csrf %>">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="field mb-1">
        <label for="username">Nama Pengguna</label>
        <input id="username" name="username" type="text" required autocomplete="username" autofocus placeholder="admin">
      </div>
      <div class="field mb-2">
        <label for="password">Kata Sandi</label>
        <input id="password" name="password" type="password" required autocomplete="current-password" placeholder="••••••••">
      </div>
      <button class="tombol blok" type="submit"><svg width="15" height="15"><use href="#i-gembok"></use></svg> Masuk ke Panel</button>
    </form>

    <div class="note mt-2 kecil">
      <strong>Akun contoh klon:</strong><br>
      Administrator — <span class="mono">admin / admin123</span><br>
      Petugas — <span class="mono">petugas / petugas123</span>
    </div>

    <p class="tengah kecil mt-2 mb-0"><a href="/">← Kembali ke situs publik</a></p>
  </div>
</div>
</body>
</html>
