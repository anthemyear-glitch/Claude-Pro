<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sisi') %>
<div class="admin-utama">
  <div class="admin-topbar">
    <div><h1><%= judul %></h1><span class="kecil samar">Hanya administrator yang dapat membuka halaman ini</span></div>
    <div class="kanan"><span class="badge-klon"><%= cfg.suffix %></span></div>
  </div>

  <div class="admin-isi">
    <% if (flash) { %><div class="pesan ok"><%= flash %></div><% } %>

    <div class="panel mb-2" id="panel-form" style="display:none">
      <div class="kepala"><h3 style="margin:0" id="judul-form">Tambah Pengguna</h3>
        <button class="tombol garis kecil" type="button" id="tutup-form">Tutup</button></div>
      <div class="isi-panel">
        <form method="post" action="/admin/pengguna/simpan" id="form-pengguna">
          <input type="hidden" name="csrf" value="<%= csrf %>">
          <input type="hidden" name="id" id="f-id">
          <div class="form-grid">
            <div class="field kolom-4">
              <label for="f-username">Nama Pengguna <span class="wajib">*</span></label>
              <input id="f-username" name="username" type="text" required maxlength="40">
            </div>
            <div class="field kolom-4">
              <label for="f-nama">Nama Lengkap <span class="wajib">*</span></label>
              <input id="f-nama" name="nama" type="text" required maxlength="100">
            </div>
            <div class="field kolom-4">
              <label for="f-email">Surel</label>
              <input id="f-email" name="email" type="email" maxlength="120">
            </div>
            <div class="field kolom-4">
              <label for="f-role">Peran</label>
              <select id="f-role" name="role">
                <option value="petugas">Petugas Layanan</option>
                <option value="admin">Administrator</option>
              </select>
              <span class="bantuan">Administrator dapat mengelola pengguna dan pengaturan situs.</span>
            </div>
            <div class="field kolom-4">
              <label for="f-password">Kata Sandi</label>
              <input id="f-password" name="password" type="password" minlength="6" autocomplete="new-password">
              <span class="bantuan">Kosongkan bila tidak mengubah kata sandi (saat menyunting).</span>
            </div>
            <div class="field kolom-4">
              <label>Status</label>
              <div class="pilihan-radio" style="margin-top:.4rem">
                <label><input type="checkbox" id="f-aktif" name="aktif" value="1" checked> Akun aktif</label>
              </div>
            </div>
          </div>
          <div class="fleks mt-2">
            <button class="tombol" type="submit"><svg width="15" height="15"><use href="#i-sukses"></use></svg> Simpan Pengguna</button>
            <button class="tombol garis" type="reset">Kosongkan</button>
          </div>
        </form>
      </div>
    </div>

    <button class="tombol mb-2" id="btn-tambah"><svg width="15" height="15"><use href="#i-plus"></use></svg> Tambah Pengguna</button>

    <div class="tabel-bungkus">
      <table class="tabel">
        <thead><tr><th class="nomor">#</th><th>Nama Pengguna</th><th>Nama Lengkap</th><th>Surel</th><th>Peran</th><th>Status</th><th>Dibuat</th><th class="kanan">Aksi</th></tr></thead>
        <tbody>
          <% baris.forEach(function(u, i){ %>
            <tr data-id="<%= u.id %>" data-username="<%= u.username %>" data-nama="<%= u.nama %>" data-email="<%= u.email || '' %>" data-role="<%= u.role %>" data-aktif="<%= u.aktif %>">
              <td class="nomor"><%= i + 1 %></td>
              <td class="mono"><%= u.username %></td>
              <td><%= u.nama %></td>
              <td class="kecil redup"><%= u.email || '—' %></td>
              <td><span class="lencana <%= u.role === 'admin' ? 'aksen' : '' %>"><%= u.role %></span></td>
              <td><span class="lencana <%= u.aktif ? 'ok' : 'warn' %>"><%= u.aktif ? 'Aktif' : 'Nonaktif' %></span></td>
              <td class="kecil samar"><%= util.tanggalPendek(u.dibuat) %></td>
              <td class="aksi">
                <button class="tombol garis kecil btn-sunting" type="button"><svg width="13" height="13"><use href="#i-sunting"></use></svg></button>
                <% if (u.id !== user.id) { %>
                  <form method="post" action="/admin/pengguna/<%= u.id %>/hapus" style="display:inline">
                    <input type="hidden" name="csrf" value="<%= csrf %>">
                    <button class="tombol garis kecil" data-konfirmasi="Hapus pengguna <%= u.username %>?" title="Hapus"><svg width="13" height="13"><use href="#i-hapus"></use></svg></button>
                  </form>
                <% } else { %>
                  <span class="lencana">akun Anda</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<script>
  (function () {
    const panel = document.getElementById('panel-form');
    const form = document.getElementById('form-pengguna');
    document.getElementById('btn-tambah').addEventListener('click', function () {
      form.reset(); document.getElementById('f-id').value = '';
      document.getElementById('f-aktif').checked = true;
      document.getElementById('judul-form').textContent = 'Tambah Pengguna';
      panel.style.display = ''; panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
    document.getElementById('tutup-form').addEventListener('click', function () { panel.style.display = 'none'; });
    document.querySelectorAll('.btn-sunting').forEach(function (b) {
      b.addEventListener('click', function () {
        const tr = b.closest('tr');
        form.reset();
        document.getElementById('f-id').value = tr.dataset.id;
        document.getElementById('f-username').value = tr.dataset.username;
        document.getElementById('f-nama').value = tr.dataset.nama;
        document.getElementById('f-email').value = tr.dataset.email;
        document.getElementById('f-role').value = tr.dataset.role;
        document.getElementById('f-aktif').checked = tr.dataset.aktif === '1';
        document.getElementById('judul-form').textContent = 'Sunting Pengguna ' + tr.dataset.username;
        panel.style.display = ''; panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      });
    });
  })();
</script>
<script src="/js/app.js"></script>
</body>
</html>
