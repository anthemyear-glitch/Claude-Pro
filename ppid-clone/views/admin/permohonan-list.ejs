<%- include('../partials/admin-head') %>
<%- include('../partials/admin-sisi') %>
<div class="admin-utama">
  <div class="admin-topbar">
    <div><h1><%= judul %></h1><span class="kecil samar"><%= util.formatAngka(hit) %> permohonan tercatat</span></div>
    <div class="kanan">
      <a class="tombol garis kecil" href="?<%= new URLSearchParams({ ...query, format: 'csv' }).toString() %>"><svg width="14" height="14"><use href="#i-unduh"></use></svg> Ekspor CSV</a>
      <span class="badge-klon"><%= cfg.suffix %></span>
    </div>
  </div>

  <div class="admin-isi">
    <% if (flash) { %><div class="pesan ok"><%= flash %></div><% } %>

    <form class="bilah-filter" method="get" action="/admin/permohonan">
      <div class="field grow">
        <label for="q">Cari</label>
        <input id="q" name="q" type="search" value="<%= query.q || '' %>" placeholder="Nomor tiket, nama, surel, atau rincian…">
      </div>
      <div class="field">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="">Semua Status</option>
          <% statusList.forEach(function(s){ %><option value="<%= s %>" <%= query.status === s ? 'selected' : '' %>><%= s %></option><% }) %>
        </select>
      </div>
      <div class="field">
        <label for="kategori">Kategori Informasi</label>
        <select id="kategori" name="kategori">
          <option value="">Semua Kategori</option>
          <% kategoriList.forEach(function(k){ %><option value="<%= k %>" <%= query.kategori === k ? 'selected' : '' %>><%= k %></option><% }) %>
        </select>
      </div>
      <div class="fleks" style="gap:.5rem">
        <button class="tombol" type="submit"><svg width="14" height="14"><use href="#i-cari"></use></svg> Saring</button>
        <a class="tombol garis" href="/admin/permohonan">Atur Ulang</a>
      </div>
    </form>

    <div class="tabel-bungkus">
      <table class="tabel">
        <thead>
          <tr><th>Tiket</th><th>Pemohon</th><th>Kategori</th><th>Rincian</th><th>Status</th><th>Masuk</th><th>Selesai</th><th>Petugas</th><th class="kanan">Aksi</th></tr>
        </thead>
        <tbody>
          <% baris.forEach(function(p){ %>
            <tr>
              <td><a href="/admin/permohonan/<%= p.id %>" class="mono" style="text-decoration:none;font-weight:600"><%= p.nomor_tiket %></a></td>
              <td><%= p.nama %><div class="mikro samar"><%= p.email %> · <%= p.telepon %></div>
                <div class="mikro samar"><%= p.jenis_pemohon %></div></td>
              <td><span class="lencana"><%= p.kategori_info %></span></td>
              <td style="max-width:280px"><%= p.rincian_info.slice(0, 90) %><%= p.rincian_info.length > 90 ? '…' : '' %></td>
              <td><span class="lencana <%= util.WARNA_STATUS[p.status] || 'info' %>"><%= p.status %></span></td>
              <td class="kecil samar"><%= util.tanggalPendek(p.dibuat) %></td>
              <td class="kecil samar"><%= p.diselesaikan ? util.tanggalPendek(p.diselesaikan) : '—' %></td>
              <td class="kecil redup"><%= p.petugas_nama || '—' %></td>
              <td class="aksi">
                <a class="tombol halus kecil" href="/admin/permohonan/<%= p.id %>">Proses</a>
                <% if (user.role === 'admin') { %>
                  <form method="post" action="/admin/permohonan/<%= p.id %>/hapus" style="display:inline">
                    <input type="hidden" name="csrf" value="<%= csrf %>">
                    <button class="tombol garis kecil" data-konfirmasi="Hapus permohonan <%= p.nomor_tiket %>?" title="Hapus"><svg width="13" height="13"><use href="#i-hapus"></use></svg></button>
                  </form>
                <% } %>
              </td>
            </tr>
          <% }) %>
          <% if (!baris.length) { %><tr><td colspan="9" class="tengah redup" style="padding:2rem">Tidak ada permohonan pada penyaringan ini.</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <%- include('../partials/paginasi', { pg: pg, baseUrl: '/admin/permohonan', query: query }) %>
  </div>
</div>
<script src="/js/app.js"></script>
</body>
</html>
