<%- include('../partials/head') %>
<%- include('../partials/topbar') %>
<%- include('../partials/header') %>

<section class="judul-halaman">
  <div class="wadah">
    <div class="breadcrumb"><a href="/">Beranda</a><span class="pisah">/</span><a href="/mekanisme">Layanan</a><span class="pisah">/</span><span>Lacak Permohonan</span></div>
    <h1><svg width="20" height="20" style="vertical-align:-2px;color:var(--aksen)"><use href="#i-lacak"></use></svg> Lacak Permohonan Informasi</h1>
    <p class="sub">Masukkan nomor tiket dan alamat surel yang digunakan saat pengajuan untuk melihat status terkini.</p>
  </div>
</section>

<main class="utama">
  <div class="wadah" style="max-width:860px">

    <div class="panel mb-2">
      <div class="kepala"><h3 style="margin:0">Formulir Pelacakan</h3><span class="lencana">Contoh tiket: PPID-<%= new Date().getFullYear() %>-00001</span></div>
      <div class="isi-panel">
        <form id="form-lacak" class="form-grid" method="get" action="/lacak-permohonan">
          <div class="field kolom-6">
            <label for="nomor_tiket">Nomor Tiket <span class="wajib">*</span></label>
            <input id="nomor_tiket" name="nomor_tiket" type="text" required value="<%= (typeof tiket !== 'undefined' && tiket) || query.tiket || '' %>" placeholder="PPID-2026-00001" class="mono">
          </div>
          <div class="field kolom-6">
            <label for="email-lacak">Surel Pemohon <span class="wajib">*</span></label>
            <input id="email-lacak" name="email" type="email" required value="<%= (typeof email !== 'undefined' && email) || query.email || '' %>" placeholder="nama@contoh.com">
            <span class="bantuan">Digunakan untuk memastikan data permohonan milik Anda.</span>
          </div>
          <div class="field kolom-12">
            <div class="fleks">
              <button class="tombol" type="submit"><svg width="15" height="15"><use href="#i-cari"></use></svg> Lacak Status</button>
              <a class="tombol garis" href="/permohonan-informasi">Ajukan Permohonan Baru</a>
            </div>
          </div>
        </form>
      </div>
    </div>

    <div id="hasil-lacak">
      <% if (typeof gagal !== 'undefined' && gagal) { %>
        <div class="pesan galat"><svg width="18" height="18"><use href="#i-peringatan"></use></svg> Nomor tiket ditemukan, namun alamat surel tidak cocok dengan data permohonan.</div>
      <% } %>
      <% if (hasil) { %>
        <div class="panel">
          <div class="kepala">
            <div>
              <h3 style="margin:0">Permohonan <%= hasil.nomor_tiket %></h3>
              <span class="kecil samar">Diajukan <%= util.tanggalID(hasil.dibuat) %> oleh <%= hasil.nama %></span>
            </div>
            <span class="lencana <%= util.WARNA_STATUS[hasil.status] || 'info' %>"><%= hasil.status %></span>
          </div>
          <div class="isi-panel">
            <div class="baris grid-2 mb-2">
              <div class="kartu"><span class="kecil samar">Kategori Informasi</span><div class="tebal"><%= hasil.kategori_info %></div></div>
              <div class="kartu"><span class="kecil samar">Cara Perolehan</span><div class="tebal"><%= hasil.cara_peroleh %></div></div>
            </div>
            <div class="mb-2"><span class="kecil samar">Rincian Informasi yang Dimohon</span><div><%= hasil.rincian_info %></div></div>
            <% if (hasil.tujuan) { %><div class="mb-2"><span class="kecil samar">Tujuan Penggunaan</span><div><%= hasil.tujuan %></div></div><% } %>
            <% if (hasil.catatan_petugas) { %><div class="note mb-2"><strong>Catatan petugas:</strong> <%= hasil.catatan_petugas %></div><% } %>
            <% if (hasil.jawaban) { %><div class="note mb-2"><strong>Jawaban:</strong> <%= hasil.jawaban %></div><% } %>
            <% if (hasil.berkas_jawaban) { %>
              <a class="tombol kecil mb-2" href="/api/unduh/jawaban/<%= encodeURIComponent(hasil.nomor_tiket) %>?email=<%= encodeURIComponent(hasil.email) %>"><svg width="14" height="14"><use href="#i-unduh"></use></svg> Unduh Berkas Jawaban</a>
            <% } %>
            <hr>
            <h4 style="margin-bottom:.6rem">Riwayat Proses</h4>
            <ul class="timeline">
              <% hasil.riwayat.forEach(function(r, i){ %>
                <li class="<%= i === hasil.riwayat.length - 1 ? 'akhir' : '' %>">
                  <span class="w"><%= util.tanggalID(r.waktu) %></span>
                  <strong><%= r.status %></strong>
                  <p><%= r.keterangan || '' %> <span class="samar">· oleh <%= r.aktor %></span></p>
                </li>
              <% }) %>
            </ul>
            <% if (hasil.status === 'Ditolak' || hasil.status === 'Perlu Kelengkapan') { %>
              <div class="pesan warn mt-2">
                <svg width="18" height="18"><use href="#i-keberatan"></use></svg>
                <div>Anda berhak mengajukan <a href="/pengajuan-keberatan">keberatan kepada Atasan PPID</a> paling lambat 30 hari kerja sejak ditemukannya alasan keberatan.</div>
              </div>
            <% } %>
          </div>
        </div>
      <% } else if (typeof gagal === 'undefined') { %>
        <div class="panel">
          <div class="isi-panel tengah redup">
            <svg width="42" height="42" style="opacity:.5"><use href="#i-lacak"></use></svg>
            <p class="mt-1 mb-0">Status permohonan akan ditampilkan di sini setelah nomor tiket dan surel diverifikasi.</p>
          </div>
        </div>
      <% } %>
    </div>

    <div class="panel mt-2">
      <div class="isi-panel">
        <h3>Pertanyaan Seputar Pelacakan</h3>
        <div class="baris grid-2">
          <div class="kartu">
            <strong>Nomor tiket saya hilang, bagaimana?</strong>
            <p class="kecil redup mb-0">Hubungi petugas layanan melalui surel atau telepon dengan menyebutkan nama dan tanggal pengajuan; petugas akan membantu menelusuri nomor tiket Anda.</p>
          </div>
          <div class="kartu">
            <strong>Mengapa status masih “Menunggu Verifikasi”?</strong>
            <p class="kecil redup mb-0">Petugas memverifikasi kelengkapan identitas dan kejelasan rincian informasi pada hari kerja. Bila ada kekurangan, Anda akan dihubungi melalui surel atau telepon.</p>
          </div>
          <div class="kartu">
            <strong>Apakah saya bisa mengubah permohonan?</strong>
            <p class="kecil redup mb-0">Perubahan rincian informasi dapat disampaikan dengan membalas surel pemberitahuan atau menghubungi petugas, dengan menyebutkan nomor tiket.</p>
          </div>
          <div class="kartu">
            <strong>Kapan berkas jawaban tersedia?</strong>
            <p class="kecil redup mb-0">Tautan unduhan muncul pada halaman ini ketika status permohonan telah “Selesai” dan petugas mengunggah berkas jawaban.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</main>

<%- include('../partials/footer') %>
<script src="/js/app.js"></script>
</body>
</html>
