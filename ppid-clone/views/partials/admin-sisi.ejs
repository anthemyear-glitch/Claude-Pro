<%/* Navigasi samping panel pengelola */%>
<aside class="admin-sisi">
  <a class="brand-mini" href="/admin">
    <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true">
      <circle cx="32" cy="32" r="28" fill="none" stroke="var(--aksen)" stroke-width="3"/>
      <path d="M32 15l12 5v10c0 8-5 14-12 16-7-2-12-8-12-16V20z" fill="none" stroke="var(--aksen-2)" stroke-width="3" stroke-linejoin="round"/>
      <path d="M26 32h12M32 26v12" stroke="var(--aksen)" stroke-width="3" stroke-linecap="round"/>
    </svg>
    <span>
      <strong>Panel Pengelola</strong>
      <span><%= cfg.siteName %> · <%= cfg.suffix %></span>
    </span>
  </a>

  <div class="grup">Ringkasan</div>
  <a class="menu <%= aktif === 'dasbor' || path === '/admin' || path === '/admin/' ? 'aktif' : '' %>" href="/admin"><svg class="ikon" width="16" height="16"><use href="#i-dasbor"></use></svg> Dasbor</a>

  <div class="grup">Layanan</div>
  <a class="menu <%= aktif === 'permohonan' ? 'aktif' : '' %>" href="/admin/permohonan"><svg class="ikon" width="16" height="16"><use href="#i-formulir"></use></svg> Permohonan Informasi
    <span class="hitung"><%= q.get("SELECT COUNT(*) AS n FROM permohonan WHERE status IN ('Menunggu Verifikasi','Diverifikasi','Sedang Diproses','Perlu Kelengkapan')").n %></span></a>
  <a class="menu <%= aktif === 'keberatan' ? 'aktif' : '' %>" href="/admin/keberatan"><svg class="ikon" width="16" height="16"><use href="#i-keberatan"></use></svg> Keberatan
    <span class="hitung"><%= q.get('SELECT COUNT(*) AS n FROM keberatan').n %></span></a>
  <a class="menu <%= aktif === 'survei' ? 'aktif' : '' %>" href="/admin/survei"><svg class="ikon" width="16" height="16"><use href="#i-bintang"></use></svg> Survei Kepuasan</a>
  <a class="menu <%= aktif === 'pesan' ? 'aktif' : '' %>" href="/admin/pesan"><svg class="ikon" width="16" height="16"><use href="#i-email"></use></svg> Pesan &amp; Pengaduan
    <span class="hitung"><%= q.get('SELECT COUNT(*) AS n FROM pesan_kontak WHERE dibaca=0').n %></span></a>

  <div class="grup">Konten Informasi</div>
  <a class="menu <%= aktif === 'dip' ? 'aktif' : '' %>" href="/admin/dip"><svg class="ikon" width="16" height="16"><use href="#i-dokumen"></use></svg> Daftar Informasi Publik</a>
  <a class="menu <%= aktif === 'kategori_dip' ? 'aktif' : '' %>" href="/admin/kategori_dip"><svg class="ikon" width="16" height="16"><use href="#i-setiapsaat"></use></svg> Kategori DIP</a>
  <a class="menu <%= aktif === 'opd' ? 'aktif' : '' %>" href="/admin/opd"><svg class="ikon" width="16" height="16"><use href="#i-opd"></use></svg> PPID Pelaksana</a>
  <a class="menu <%= aktif === 'regulasi' ? 'aktif' : '' %>" href="/admin/regulasi"><svg class="ikon" width="16" height="16"><use href="#i-regulasi"></use></svg> Regulasi</a>

  <div class="grup">Publikasi</div>
  <a class="menu <%= aktif === 'berita' ? 'aktif' : '' %>" href="/admin/berita"><svg class="ikon" width="16" height="16"><use href="#i-berita"></use></svg> Berita</a>
  <a class="menu <%= aktif === 'video' ? 'aktif' : '' %>" href="/admin/video"><svg class="ikon" width="16" height="16"><use href="#i-video"></use></svg> Video</a>
  <a class="menu <%= aktif === 'infografis' ? 'aktif' : '' %>" href="/admin/infografis"><svg class="ikon" width="16" height="16"><use href="#i-grafis"></use></svg> Infografis</a>
  <a class="menu <%= aktif === 'slider' ? 'aktif' : '' %>" href="/admin/slider"><svg class="ikon" width="16" height="16"><use href="#i-mata"></use></svg> Slider Beranda</a>
  <a class="menu <%= aktif === 'halaman' ? 'aktif' : '' %>" href="/admin/halaman"><svg class="ikon" width="16" height="16"><use href="#i-tulis"></use></svg> Halaman Statis</a>
  <a class="menu <%= aktif === 'faq' ? 'aktif' : '' %>" href="/admin/faq"><svg class="ikon" width="16" height="16"><use href="#i-faq"></use></svg> FAQ</a>

  <div class="grup">Sistem</div>
  <% if (user.role === 'admin') { %>
    <a class="menu <%= aktif === 'pengguna' ? 'aktif' : '' %>" href="/admin/pengguna"><svg class="ikon" width="16" height="16"><use href="#i-pengguna"></use></svg> Pengguna</a>
    <a class="menu <%= aktif === 'pengaturan' ? 'aktif' : '' %>" href="/admin/pengaturan"><svg class="ikon" width="16" height="16"><use href="#i-setelan"></use></svg> Pengaturan Situs</a>
  <% } %>
  <a class="menu <%= aktif === 'audit' ? 'aktif' : '' %>" href="/admin/audit"><svg class="ikon" width="16" height="16"><use href="#i-log"></use></svg> Log Aktivitas</a>
  <a class="menu" href="/" target="_blank" rel="noopener"><svg class="ikon" width="16" height="16"><use href="#i-tautan"></use></svg> Lihat Situs Publik</a>

  <hr style="margin:.9rem .3rem">
  <form method="post" action="/admin/logout">
    <input type="hidden" name="csrf" value="<%= csrf %>">
    <button class="menu" style="width:100%;background:transparent;border:0;cursor:pointer;font-family:inherit" type="submit">
      <svg class="ikon" width="16" height="16"><use href="#i-keluar"></use></svg> Keluar (<%= user.nama.split(' ')[0] %>)
    </button>
  </form>
</aside>
